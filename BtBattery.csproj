<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The 10.0.19041.0 suffix unlocks the Windows Runtime (WinRT) APIs,
         including Windows.Devices.Enumeration which gives us DeviceWatcher. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Lowest Windows build we promise to run on. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Icon shown on the .exe file itself (Explorer, taskbar button). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bake the tray image into the .exe so it ships as a single self-contained file. -->
    <EmbeddedResource Include="tray_icon.png" />
  </ItemGroup>

</Project>
